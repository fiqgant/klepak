# Supabase project URL and anon (public) key.
# Both are safe to expose to the browser — the anon key only grants what
# Row Level Security policies in supabase/schema.sql allow.
# Never put the service role key in a NEXT_PUBLIC_* variable or anywhere
# in client-side code.


NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key